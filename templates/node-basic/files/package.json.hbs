{
  "name": "{{project_name}}",
  "version": "0.1.0",
  "description": "{{description}}",
  {{#if author}}
  "author": "{{author}}",
  {{/if}}
  {{#if license}}
  {{#unless (eq license "none")}}
  "license": "{{license}}",
  {{/unless}}
  {{/if}}
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    {{#if use_eslint}}
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    {{else}}
    "lint": "tsc --noEmit",
    {{/if}}
    {{#if use_prettier}}
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    {{/if}}
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    {{#if use_eslint}}
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    {{/if}}
    "jest": "^29.0.0",
    {{#if use_prettier}}
    "prettier": "^3.0.0",
    {{/if}}
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
