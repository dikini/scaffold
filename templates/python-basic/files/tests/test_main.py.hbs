"""Tests for the main module."""

import pytest

from {{project_name}}.main import hello_world


class TestHelloWorld:
    """Test cases for hello_world function."""

    def test_hello_world_returns_greeting(self) -> None:
        """Test that hello_world returns the expected greeting."""
        result = hello_world()
        assert result == "Hello, World!"

    def test_hello_world_returns_string(self) -> None:
        """Test that hello_world returns a string."""
        result = hello_world()
        assert isinstance(result, str)

    def test_hello_world_not_empty(self) -> None:
        """Test that hello_world does not return an empty string."""
        result = hello_world()
        assert len(result) > 0


